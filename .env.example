# Copy to `.env` locally. Never commit real secrets or real API keys.
# Values below are placeholders and are not usable as production credentials.

TAVO_MIGRATE_DATABASE_URL=postgres://tavo_migrator:change-me@127.0.0.1:5432/tavo
DATABASE_URL=postgres://tavo_app:change-me@127.0.0.1:5432/tavo

# JSON object: apiKey -> tenant UUID (use a local-only key, not a cloud token)
TAVO_API_KEYS={"local-dev-key":"00000000-0000-0000-0000-00000000000a"}

# JSON: version -> 64 hex characters (32 bytes). Generate locally; do not commit real keys.
# Example shape only — replace REPLACE_ME_WITH_LOCAL_64_HEX with output of:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TAVO_PHONE_HMAC_KEYS={"1":"REPLACE_ME_WITH_LOCAL_64_HEX"}
TAVO_PHONE_ENCRYPTION_KEYS={"1":"REPLACE_ME_WITH_LOCAL_64_HEX"}
TAVO_PHONE_HMAC_WRITE_VERSION=1
TAVO_PHONE_ENCRYPTION_WRITE_VERSION=1

# Distinct from phone encryption. 32-byte hex keys.
TAVO_MESSAGE_ENCRYPTION_KEYS={"1":"REPLACE_ME_WITH_LOCAL_64_HEX"}
TAVO_MESSAGE_ENCRYPTION_WRITE_VERSION=1

# Meta Cloud API (Phase 2A). Verify token and app secret are not Graph user tokens.
TAVO_META_APP_SECRET=replace-me
TAVO_META_VERIFY_TOKEN=replace-me
TAVO_ROUTING_HMAC_KEY=REPLACE_ME_WITH_LOCAL_64_HEX

TAVO_LOG_LEVEL=info
