{
  "name": "tavo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "secrets": "node scripts/scan-secrets.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "cyclonedx-npm --ignore-npm-errors -o sbom.cdx.json",
    "test": "npm run test -w @tavo/shared && npm run test -w @tavo/security && npm run test -w @tavo/database && npm run test -w @tavo/domain && npm run test -w @tavo/whatsapp && npm run test -w @tavo/ai && npm run test -w @tavo/orchestrator && npm run test -w @tavo/api",
    "eval:real": "npm run eval:real -w @tavo/ai",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.0.0",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "license-checker": "^25.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  }
}
